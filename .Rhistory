rename(Tech_Type = Type)
Pharma <- Pharma %>%
rename(Pharma_Id = Id)
PharmaProds <- PharmaProds %>%
rename(Pharma_Prod_Type = Type) %>%
rename(Pharma_Prod_Id = Id)
